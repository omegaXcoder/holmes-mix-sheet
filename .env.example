# Service Autopilot login
SA_EMAIL=alpha@kudos.marketing
# Quote the value if it contains "#" - dotenv treats an unquoted "#" as a comment start
# and silently truncates everything after it.
SA_PASSWORD=

# Path to the Google service account JSON key (see README for setup)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Google Drive folder that contains the monthly "<Month> <Year> Mix Sheet" spreadsheets
# (from https://drive.google.com/drive/folders/<THIS_ID>)
MIX_SHEETS_FOLDER_ID=1KsCqKKnZOTAJbkXRf80ZT1JLF3ul-pzN

# IANA timezone the business operates in - used to compute "yesterday" and week boundaries
BUSINESS_TIMEZONE=America/Denver

# Set to "true" to scrape and compute everything but skip writing to the sheet (prints instead)
DRY_RUN=true

# Set to "true" to run Playwright headless (no visible browser window)
HEADLESS=false

# Email summary sent after every run (success or failure), listing every reduced job and
# sq ft per tech for auditing. See README "Email notifications" for setup.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_EMAIL=
SMTP_APP_PASSWORD=
NOTIFY_EMAIL_TO=omega@kudos.marketing
