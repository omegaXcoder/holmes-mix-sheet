# Service Autopilot login
SA_EMAIL=alpha@kudos.marketing
# Quote the value if it contains "#" - dotenv treats an unquoted "#" as a comment start
# and silently truncates everything after it.
SA_PASSWORD=

# Path to the Google service account JSON key (see README for setup)
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Google Drive folder that contains the year subfolders ("Mix Sheets 26'" etc) holding the
# monthly "<Month> <Year> Mix Sheet" spreadsheets (from
# https://drive.google.com/drive/folders/<THIS_ID>). Since 2026-09-02 this is the ROOT of
# the "Drive" SHARED drive (0A... ids are shared-drive roots), which fixed the service
# account storage-quota problem - see README "Drive storage quota / monthly sheet creation".
MIX_SHEETS_FOLDER_ID=0AIRkxE8Y7Sr8Uk9PVA

# Template spreadsheet duplicated to create each new month's Mix Sheet automatically the
# first time it's needed (e.g. first run of a new month). Named "NEW MASTER 2026 FILL
# SHEET" as of 2026-08. NOTE: as of 2026-09-02 it still lives in the OLD My Drive "Mix
# Sheets" folder owned by service@holmesutah.com - it should be moved into the shared
# drive (the ID survives the move, so this value stays correct) so the service account's
# drive membership covers reading it; until then the service account needs an explicit
# share on it or the first run of a new month can't copy it.
MIX_SHEET_TEMPLATE_ID=1g8E39SjoRwQUH-mmUUf0F7TMLUX7KC8cOVyxwKyX3bE

# Optional - only needed if the Mix Sheets folder is in a regular My Drive (NOT a Shared
# Drive). Service accounts have 0 bytes of Drive storage (Google policy change, April
# 2025), so creating a new month's sheet from the template fails with "storage quota
# exceeded" unless either the folder lives in a Shared Drive, or this is set to a real
# Workspace user's email (e.g. madison@holmesutah.com) AND the service account has been
# granted domain-wide delegation for that domain - see README "Drive storage quota /
# monthly sheet creation" for both setups. Leave empty when using a Shared Drive.
GOOGLE_IMPERSONATE_USER=

# IANA timezone the business operates in - used to compute tomorrow's date and week boundaries
BUSINESS_TIMEZONE=America/Denver

# Set to "true" to scrape and compute everything but skip writing to the sheet (prints instead)
DRY_RUN=true

# Set to "true" to run Playwright headless (no visible browser window)
HEADLESS=false

# Set to "true" to dump a screenshot + the target element's computed style/bounding box to
# debug-screenshots/ if a filter-switch click ever fails - see README fragile point #11
DEBUG_SCREENSHOTS=false

# Testing only - pretend "now" is this instant instead of the real current time (e.g.
# 2026-08-22T12:00:00-06:00 to test as if today were a Saturday). Leave unset for real runs.
SIMULATE_NOW=

# Email summary sent after every run (success or failure), listing every reduced job and
# sq ft per tech for auditing. See README "Email notifications" for setup.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_FROM_EMAIL=
SMTP_APP_PASSWORD=
# Comma-separated list for multiple recipients
NOTIFY_EMAIL_TO=omega@kudos.marketing,madison@holmesutah.com
